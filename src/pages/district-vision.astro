---
import Layout from '../layouts/Layout.astro';
import SubNav from '../components/SubNav.astro';
import SubFooter from '../components/SubFooter.astro';
import EarlyNote from '../components/EarlyNote.astro';
import { Image } from 'astro:assets';

import plaza from '../assets/pages/plaza.jpg';
import streetRetail from '../assets/pages/street-retail.jpg';
import wellnessStreet from '../assets/pages/wellness-street.jpg';
import waterCourtyards from '../assets/pages/water-courtyards.jpg';
import townhomes from '../assets/pages/townhomes.jpg';
import sportsDay from '../assets/pages/sports-day.jpg';
import market from '../assets/pages/morning-market.jpg';
import scandiAerial from '../assets/pages/scandi-aerial.jpg';
import interiorDining from '../assets/pages/interior-dining.jpg';
import interiorBedroom from '../assets/pages/interior-bedroom.jpg';
import communityTable from '../assets/pages/community-table.jpg';
import communityGarden from '../assets/pages/community-garden.jpg';
import courtyardDusk from '../assets/pages/evening-courtyard.jpg';
import omPlacemaking from '../assets/pages/om-placemaking.jpg';
import omResilience from '../assets/pages/om-resilience.jpg';
import omFood from '../assets/pages/om-food.jpg';
import omLandscape from '../assets/pages/om-landscape.jpg';
import omWomen from '../assets/pages/om-women.jpg';
import oregonCoast from '../assets/pages/oregon-coast.jpg';
import silverFalls from '../assets/pages/silver-falls.jpg';
import vineyard from '../assets/pages/vineyard.jpg';
import oregonBiking from '../assets/pages/oregon-biking.jpg';

const description =
  'One connected neighborhood: housing, work, play, food, wellness, and mobility sharing the same few acres. The Now City district vision, taking shape in Oregon.';

const gallery = [
  { img: plaza, cap: 'The central park and plaza, where the district gathers.' },
  { img: streetRetail, cap: 'Street level: courtyard living behind walkable retail edges.' },
  { img: wellnessStreet, cap: 'The wellness neighborhood: family services on quiet green streets.' },
  { img: waterCourtyards, cap: 'Water, courtyards, and everyday life.' },
  { img: townhomes, cap: 'Townhomes with front doors on the street.' },
  { img: sportsDay, cap: 'The sports and recreation district by day.' },
];
const nature = [
  { img: oregonCoast, cap: 'The Oregon Coast, an easy day trip.' },
  { img: silverFalls, cap: 'Forests, waterfalls, and mountains in every direction.' },
  { img: vineyard, cap: 'Surrounded by vineyards, farms, and food.' },
  { img: oregonBiking, cap: 'Four-season outdoor living.' },
];
---

<Layout title="District Vision" description={description}>
  <SubNav current="/district-vision" />

  <section class="pt-12 md:pt-16">
    <div class="container-wide">
      <div class="overflow-hidden rounded-md shadow-sm">
        <Image src={plaza} alt="A central park and plaza surrounded by mid-rise timber buildings." widths={[800, 1400, 1920]} sizes="(min-width: 1024px) 1100px, 100vw" class="h-auto w-full object-cover" loading="eager" />
      </div>
      <div class="mt-10 max-w-3xl">
        <p class="eyebrow">District Vision</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-forest-700 md:text-5xl">A neighborhood, made whole.</h1>
        <p class="lede mt-6">One connected neighborhood where housing, work, play, food, wellness, and mobility share the same few acres. Concept renderings of our first district, taking shape in Oregon.</p>
        <EarlyNote />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <p class="eyebrow">The Place</p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl text-forest-700 md:text-4xl">One connected place.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {gallery.map(({ img, cap }) => (
          <figure>
            <div class="overflow-hidden rounded-md shadow-sm"><Image src={img} alt={cap} widths={[700, 1200, 1920]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div>
            <figcaption class="mt-2 text-xs text-stone-500">{cap}</figcaption>
          </figure>
        ))}
      </div>
      <figure class="mt-6">
        <div class="overflow-hidden rounded-md shadow-sm"><Image src={market} alt="A market hall full of daily life." widths={[800, 1400, 2000]} sizes="(min-width: 1024px) 1100px, 100vw" class="h-auto w-full object-cover" /></div>
        <figcaption class="mt-2 text-xs text-stone-500">The Now City Market: the daily civic marketplace at the heart of it all.</figcaption>
      </figure>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Living Here</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">The first block sets the tone.</h2>
        <p class="prose-body mt-5">The first courtyard blocks are designed around Scandinavian courtyard urbanism and Japanese garden philosophy: family-friendly density wrapped around quiet interior gardens, with retail and daily life at the street edge. Light-filled homes blend natural materials and Nordic simplicity with high-performance building systems: places people can imagine renting, owning, and staying.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-md border border-stone-100 bg-white p-6"><h3 class="font-display text-xl text-forest-700">A Quiet Center</h3><p class="prose-body mt-3 !text-base">Interior gardens with kid-safe green space: calm at the heart of density, supervision built into everyday life.</p></div>
        <div class="rounded-md border border-stone-100 bg-white p-6"><h3 class="font-display text-xl text-forest-700">An Active Edge</h3><p class="prose-body mt-3 !text-base">Experiential retail, cafés, and innovation workspace face the street: daily errands on foot, neighbors by default.</p></div>
        <div class="rounded-md border border-stone-100 bg-white p-6"><h3 class="font-display text-xl text-forest-700">A Home That Works</h3><p class="prose-body mt-3 !text-base">Studios to three-bedroom townhomes; high-performance systems that lower energy bills and support everyday wellness.</p></div>
      </div>

      <div class="mt-10 grid overflow-hidden rounded-md border border-stone-100 bg-white md:grid-cols-2">
        <div class="p-8 md:p-10">
          <p class="eyebrow">A Better Way to Live</p>
          <h3 class="mt-2 font-display text-2xl text-forest-700">Home as Sanctuary</h3>
          <p class="prose-body mt-4 !text-[15px]">Light-filled homes blend natural materials and Nordic simplicity with high-performance building systems that improve comfort, reduce energy costs, and support everyday wellness.</p>
        </div>
        <div class="min-h-[260px]"><Image src={interiorBedroom} alt="A serene timber bedroom." widths={[700, 1326]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>
      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-white md:grid-cols-2">
        <div class="p-8 md:p-10 md:order-2">
          <p class="eyebrow">Daily Life Within Reach</p>
          <h3 class="mt-2 font-display text-2xl text-forest-700">An Economy of Care</h3>
          <p class="prose-body mt-4 !text-[15px]">The ground floors are programmed around the parts of life that happen every day: childcare, wellness, food, and small business, so caregiving, connection, and community are built into the block rather than driven to. Long tables, shared gardens, and front doors on the street make neighbors the default.</p>
        </div>
        <div class="min-h-[260px] md:order-1"><Image src={communityTable} alt="Neighbors at a long shared table." widths={[700, 1398]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <figure><div class="overflow-hidden rounded-md shadow-sm"><Image src={courtyardDusk} alt="Courtyard at dusk with landscape lighting." widths={[700, 1400]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div><figcaption class="mt-2 text-xs text-stone-500">The courtyard at dusk.</figcaption></figure>
        <figure><div class="overflow-hidden rounded-md shadow-sm"><Image src={interiorDining} alt="A dining room holding daily life." widths={[700, 1330]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div><figcaption class="mt-2 text-xs text-stone-500">Rooms that hold daily life.</figcaption></figure>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <figure><div class="overflow-hidden rounded-md shadow-sm"><Image src={scandiAerial} alt="The first block from above." widths={[700, 1302]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div><figcaption class="mt-2 text-xs text-stone-500">The first block from above.</figcaption></figure>
        <figure><div class="overflow-hidden rounded-md shadow-sm"><Image src={communityGarden} alt="Garden beds and shared harvests." widths={[700, 1800]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div><figcaption class="mt-2 text-xs text-stone-500">Garden beds, shared harvests.</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Impact &amp; Placemaking</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">Designed for everyday vitality.</h2>
        <p class="prose-body mt-5">Now City's mission is to accelerate the transition to regenerative, resilient, and equitable communities and cities.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6"><h3 class="font-display text-xl text-forest-700">Regeneration</h3><p class="prose-body mt-3 !text-base">Restore the natural systems that sustain daily life (clean air, water, soil, and food), improving personal health while rebuilding ecological function at the neighborhood and district scale.</p></div>
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6"><h3 class="font-display text-xl text-forest-700">Resilience</h3><p class="prose-body mt-3 !text-base">Homes, mobility, energy, food, and social systems are designed to perform under stress (climate and economic disruption), strengthening household security and community-wide stability.</p></div>
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6"><h3 class="font-display text-xl text-forest-700">Equity</h3><p class="prose-body mt-3 !text-base">Designing around the realities of caregiving, childhood, aging, mobility independence, and access to opportunity improves daily life for individuals while creating more stable, connected, and inclusive communities for all.</p></div>
      </div>

      <div class="mt-10 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Regenerative Placemaking</h3>
          <ul class="mt-4 space-y-3 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Built for Well-Being</strong>: biophilic streetscapes, shaded walking paths, green plazas, and active gathering spaces that support daily movement, mental health, and social connection</li>
            <li><strong class="text-forest-800">Culture &amp; Flavor</strong>: breweries, food halls, artisan retail, and year-round programming that celebrate local creativity, craft, and regional identity</li>
            <li><strong class="text-forest-800">Innovation in Daily Life</strong>: maker spaces, startup studios, and flexible work environments that place entrepreneurship, research, and creation directly into the fabric of the district</li>
            <li><strong class="text-forest-800">Connected Living</strong>: walkable streets, safe bike networks, and future-forward transit connections that seamlessly link the district to downtown and the region</li>
          </ul>
        </div>
        <div class="min-h-[260px]"><Image src={omPlacemaking} alt="Street life in the district." widths={[655]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10 md:order-2">
          <h3 class="font-display text-2xl text-forest-700">Resilience by Design</h3>
          <p class="prose-body mt-3 !text-[15px]">The district is designed to quietly become a resilience hub, not through emergency labeling, but through everyday civic life. By anchoring the district in shared gathering, local infrastructure, and walkable access to daily needs, resilience emerges naturally as a byproduct of good urban design.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Sports and event spaces</strong> designed to serve double duty as community response anchors</li>
            <li><strong class="text-forest-800">District-scale green infrastructure</strong> integrating power, heating and cooling, wastewater, last-mile mobility, and data infrastructure for continuous operation under stress</li>
            <li><strong class="text-forest-800">High-paying innovation jobs + regenerative placemaking</strong> connecting people to nature, heritage, and long-term opportunity</li>
          </ol>
        </div>
        <div class="min-h-[260px] md:order-1"><Image src={omResilience} alt="Resilient district systems." widths={[945]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Beyond Agrihoods: Food as District Infrastructure</h3>
          <p class="prose-body mt-3 !text-[15px]">A living innovation framework to design, test, and scale urban and rural circular food systems. By linking regenerative agriculture, food logistics, local markets, waste recovery, and community participation, the district becomes a real-world platform for proving what truly resilient food economies look like.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Urban and rural circular food systems</strong> connecting regional regenerative farms with on-site processing, markets, and daily life</li>
            <li><strong class="text-forest-800">Living testbed for agri-tech, soil, and food innovation</strong> supporting founders, researchers, and farmers</li>
            <li><strong class="text-forest-800">Closed-loop nutrient and organic waste recovery</strong> feeding back into regional food production</li>
            <li><strong class="text-forest-800">Scalable agrihood innovation framework</strong> that can be replicated globally</li>
          </ol>
        </div>
        <div class="min-h-[260px]"><Image src={omFood} alt="A food hall and market." widths={[993]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10 md:order-2">
          <h3 class="font-display text-2xl text-forest-700">Landscape Intelligence: Designing Nature as Infrastructure</h3>
          <p class="prose-body mt-3 !text-[15px]">Treating landscape as living infrastructure: integrated ecology, climate adaptation, social systems, and public health. Designing with nature's logic, not tacking nature onto development.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">"City-Nature" as foundational infrastructure</strong>: ecology woven into streets, plazas, and open space as a working system</li>
            <li><strong class="text-forest-800">Climate and water performance by design</strong>: cooling, stormwater, and microclimate regulation through living landscapes</li>
            <li><strong class="text-forest-800">Health, biodiversity, and public life integrated</strong>: landscapes that support well-being, habitat, and social connection at once</li>
            <li><strong class="text-forest-800">Adaptive and evolving open space</strong>: flexible landscapes that change with use, seasons, and the district's growth</li>
          </ol>
        </div>
        <div class="min-h-[260px] md:order-1"><Image src={omLandscape} alt="Nature woven through the district." widths={[787]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Women-First, Family-First, and Aging-In-Place Design</h3>
          <p class="prose-body mt-3 !text-[15px]">Communities designed around the daily realities of women, children, and aging adults consistently outperform conventional development on health, safety, stability, and long-term value. A women-first lens creates places that work better for everyone.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Aging-in-place housing and services</strong> supporting independence, dignity, and reduced healthcare burden over time</li>
            <li><strong class="text-forest-800">Child-centered public realm</strong> with safe mobility, nature-based play, and everyday supervision through active streets</li>
            <li><strong class="text-forest-800">Women-first safety, access, and care design</strong> shown to increase walkability, retail vitality, and neighborhood stability</li>
            <li><strong class="text-forest-800">Intergenerational community fabric</strong> proven to reduce isolation, improve mental health, and increase long-term residency</li>
          </ol>
        </div>
        <div class="min-h-[260px]"><Image src={omWomen} alt="A community designed around women and families." widths={[1256]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Oregon</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">An hour from everything worth loving.</h2>
        <p class="prose-body mt-5">The first neighborhood is rising in one of the most livable and productive regions in the country: world-class nature in every direction, a growing innovation economy, and an under-recognized quality of life. Portland and its international airport within easy reach; the coast, the mountains, and wine country within about an hour. Oregon ranked first in the nation for inbound movers in 2025.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {nature.map(({ img, cap }) => (
          <figure>
            <div class="overflow-hidden rounded-md shadow-sm"><Image src={img} alt={cap} widths={[500, 900, 1400]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] h-auto w-full object-cover" /></div>
            <figcaption class="mt-2 text-xs text-stone-500">{cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="prose-body mt-10 max-w-3xl">Want to go deeper? The thinking behind all of it lives in <a href="/manifesto">the manifesto</a>, the daily rhythm in <a href="/neighborhood">a day here</a>, and the homes themselves at <a href="/homes">homes</a>.</p>
    </div>
  </section>

  <SubFooter />
</Layout>

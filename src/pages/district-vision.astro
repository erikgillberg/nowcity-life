---
import Layout from '../layouts/Layout.astro';
import SubNav from '../components/SubNav.astro';
import SubFooter from '../components/SubFooter.astro';
import EarlyNote from '../components/EarlyNote.astro';
import Figure from '../components/Figure.astro';
import { Image } from 'astro:assets';

import plaza from '../assets/pages/plaza.jpg';
import streetRetail from '../assets/pages/street-retail.jpg';
import wellnessStreet from '../assets/pages/wellness-street.jpg';
import waterCourtyards from '../assets/pages/water-courtyards.jpg';
import townhomes from '../assets/pages/townhomes.jpg';
import sportsDay from '../assets/pages/sports-day.jpg';
import market from '../assets/pages/morning-market.jpg';
import scandiAerial from '../assets/pages/scandi-aerial.jpg';
import omPlacemaking from '../assets/pages/om-placemaking.jpg';
import omResilience from '../assets/pages/om-resilience.jpg';
import omFood from '../assets/pages/om-food.jpg';
import omLandscape from '../assets/pages/om-landscape.jpg';
import omWomen from '../assets/pages/om-women.jpg';
import oregonCoast from '../assets/pages/oregon-coast.jpg';
import silverFalls from '../assets/pages/silver-falls.jpg';
import vineyard from '../assets/pages/vineyard.jpg';
import oregonBiking from '../assets/pages/oregon-biking.jpg';

const description =
  'How a neighborhood like this gets made: what Copenhagen teaches, what the best districts prove, and the method we are running in Oregon.';

const cph = [
  { c: 'A 1947 plan pointed growth along transit lines with nature between them, and the city has compounded on that decision ever since.', h: 'We plan the whole district first, then build in phases, so every phase makes the plan stronger.' },
  { c: 'Streets are designed for bodies before vehicles. More people cross the city center by bike than by car, and the bike lanes get plowed first.', h: 'Walk-first streets and a safe bike network, so kids can reach school and friends on their own.' },
  { c: 'Daily life is a five-minute affair: market halls, courtyard gardens, and corner life woven into every block.', h: 'A market at the heart of the district, daily needs within a short walk of every front door.' },
  { c: 'The harbor went from industrial to swimmable in a generation, because the city treated water as public wealth.', h: 'Water treated as a resource and a gathering place, from stormwater gardens to splash plazas.' },
  { c: 'Comfort runs on systems: district heating serves nearly the whole city, and whole-life carbon limits are written into the building code.', h: 'District-scale energy and healthy, high-performance homes as the default, never the upgrade.' },
];

const precedents = [
  { where: 'Tempe, Arizona', name: 'Culdesac', lesson: 'A car-free neighborhood is thriving in the least likely state for it. American demand for this life is real and measured.' },
  { where: 'Portland, Oregon', name: 'The Pearl District', lesson: 'Old industrial land became a beloved neighborhood because the public realm commitments came first, before the towers.' },
  { where: 'Stockholm, Sweden', name: 'Hammarby Sjöstad', lesson: 'Energy, water, and waste designed as one loop cut the district’s footprint dramatically. Systems thinking works at neighborhood scale.' },
  { where: 'Freiburg, Germany', name: 'Vauban', lesson: 'Design a district around children and the streets fill with them. Family life is the truest measure of a place.' },
  { where: 'Chattahoochee Hills, Georgia', name: 'Serenbe', lesson: 'Put food and wellness at the center of community life and people organize their lives around it.' },
  { where: 'Brooklyn Navy Yard, New York', name: 'Newlab', lesson: 'An innovation district works when makers sit inside a real place, and the jobs weave into the neighborhood instead of beside it.' },
];
---

<Layout title="How We Build" description={description}>
  <SubNav current="/district-vision" />

  <section class="pt-12 md:pt-16">
    <div class="container-wide">
      <Figure src={plaza} alt="A central park and plaza surrounded by mid-rise timber buildings." cap="The central park and plaza: where the district gathers. Concept rendering." widths={[800, 1400, 1920]} sizes="(min-width: 1024px) 1100px, 100vw" eager={true} />
      <div class="mt-10 max-w-3xl">
        <p class="eyebrow">How We Build</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-forest-700 md:text-5xl">How a neighborhood like this gets made.</h1>
        <p class="lede mt-6">A day here is easy to fall for. This page is for everyone who wants the how: what the most livable city in the world teaches, what the best districts prove, and the method we are running in Oregon.</p>
        <EarlyNote />
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Teacher</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">What the most livable city in the world knows.</h2>
        <p class="prose-body mt-5">Copenhagen keeps winning the world's livability rankings, and it is not luck. It is fifty years of deliberate choices, made early and compounded patiently. Five of those choices shape everything we are building:</p>
      </div>
      <div class="mt-10 grid gap-5">
        {cph.map(({ c, h }, i) => (
          <div class="grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
            <div class="border-b border-stone-100 p-6 md:border-b-0 md:border-r">
              <p class="eyebrow !text-[10px]">In Copenhagen</p>
              <p class="prose-body mt-2 !text-[15px]">{c}</p>
            </div>
            <div class="bg-white p-6">
              <p class="eyebrow !text-[10px] !text-forest-500">Here</p>
              <p class="prose-body mt-2 !text-[15px]">{h}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Proof</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">Places that already proved it.</h2>
        <p class="prose-body mt-5">None of what we are doing requires believing something that has never worked. Every piece has a place that proved it. Six we study closely:</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {precedents.map(({ where, name, lesson }) => (
          <div class="rounded-md border border-stone-100 bg-white p-6">
            <p class="eyebrow !text-[10px]">{where}</p>
            <h3 class="mt-1 font-display text-xl text-forest-700">{name}</h3>
            <p class="prose-body mt-3 !text-[15px]">{lesson}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Method</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">Four layers, one sequence.</h2>
        <p class="prose-body mt-5">We design the neighborhood as one product, in four layers engineered together: <strong>regenerative placemaking</strong> (the living systems and daily rituals that make a place more alive every year), <strong>green infrastructure</strong> (energy, water, and nature doing real work at district scale), <strong>industrialized construction</strong> (homes built with factory precision, so quality rises while cost falls), and <strong>innovative finance</strong> (patient capital and ownership models that let residents share the value they help create).</p>
        <p class="prose-body mt-4">The sequence matters as much as the layers. The land speaks first: hydrology, ecology, climate, and the existing community shape the plan before any pro forma does. The systems are designed next, the money is structured around them, and then we build, phase by phase, and stay: measuring how the place actually performs and letting each phase teach the next. <a href="/manifesto">The manifesto</a> holds the full argument.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Figure src={scandiAerial} alt="The first courtyard block from above." cap="The first block: a courtyard wrapped in daily life. Concept rendering." aspect="aspect-[4/3]" widths={[700, 1302]} />
        <Figure src={market} alt="The market hall." cap="The market: the daily civic marketplace, and the district's first heartbeat." aspect="aspect-[4/3]" widths={[700, 1200, 2000]} />
      </div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Plan</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">What it adds up to.</h2>
        <p class="prose-body mt-5">One connected district where housing, work, play, food, wellness, and mobility share the same few acres, delivered in phases over the next several years. Concept renderings from the current plan:</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Figure src={streetRetail} alt="Street level with courtyard living behind walkable retail." cap="Street level: courtyard living behind walkable retail edges." widths={[700, 1200, 1920]} />
        <Figure src={wellnessStreet} alt="Family services on quiet green streets." cap="The wellness neighborhood: family services on quiet green streets." widths={[700, 1200, 1920]} />
        <Figure src={waterCourtyards} alt="Water features and courtyards." cap="Water, courtyards, and everyday life." widths={[700, 1200, 1920]} />
        <Figure src={townhomes} alt="Townhomes with front doors on the street." cap="Townhomes with front doors on the street." widths={[700, 1200, 1920]} />
      </div>
      <div class="mt-6"><Figure src={sportsDay} alt="The sports and recreation district." cap="The sports and recreation district by day." aspect="aspect-[21/9]" widths={[800, 1400, 1920]} sizes="(min-width: 1024px) 1100px, 100vw" /></div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Impact &amp; Placemaking</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">Designed for everyday vitality.</h2>
        <p class="prose-body mt-5">Now City's mission is to accelerate the transition to regenerative, resilient, and equitable communities and cities. Here is how that mission shows up in the design:</p>
      </div>

      <div class="mt-10 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Regenerative Placemaking</h3>
          <ul class="mt-4 space-y-3 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Built for Well-Being</strong>: biophilic streetscapes, shaded walking paths, green plazas, and active gathering spaces that support daily movement, mental health, and social connection</li>
            <li><strong class="text-forest-800">Culture &amp; Flavor</strong>: breweries, food halls, artisan retail, and year-round programming that celebrate local creativity, craft, and regional identity</li>
            <li><strong class="text-forest-800">Innovation in Daily Life</strong>: maker spaces, startup studios, and flexible work environments that place entrepreneurship, research, and creation directly into the fabric of the district</li>
            <li><strong class="text-forest-800">Connected Living</strong>: walkable streets, safe bike networks, and future-forward transit connections that seamlessly link the district to downtown and the region</li>
          </ul>
        </div>
        <div class="min-h-[280px]"><Image src={omPlacemaking} alt="Street life in the district." widths={[655]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10 md:order-2">
          <h3 class="font-display text-2xl text-forest-700">Resilience by Design</h3>
          <p class="prose-body mt-3 !text-[15px]">The district is designed to quietly become a resilience hub, not through emergency labeling, but through everyday civic life. By anchoring the district in shared gathering, local infrastructure, and walkable access to daily needs, resilience emerges naturally as a byproduct of good urban design.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Sports and event spaces</strong> designed to serve double duty as community response anchors</li>
            <li><strong class="text-forest-800">District-scale green infrastructure</strong> integrating power, heating and cooling, wastewater, last-mile mobility, and data infrastructure for continuous operation under stress</li>
            <li><strong class="text-forest-800">High-paying innovation jobs + regenerative placemaking</strong> connecting people to nature, heritage, and long-term opportunity</li>
          </ol>
        </div>
        <div class="min-h-[280px] md:order-1"><Image src={omResilience} alt="Resilient district systems." widths={[945]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Beyond Agrihoods: Food as District Infrastructure</h3>
          <p class="prose-body mt-3 !text-[15px]">A living innovation framework to design, test, and scale urban and rural circular food systems. By linking regenerative agriculture, food logistics, local markets, waste recovery, and community participation, the district becomes a real-world platform for proving what truly resilient food economies look like.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Urban and rural circular food systems</strong> connecting regional regenerative farms with on-site processing, markets, and daily life</li>
            <li><strong class="text-forest-800">Living testbed for agri-tech, soil, and food innovation</strong> supporting founders, researchers, and farmers</li>
            <li><strong class="text-forest-800">Closed-loop nutrient and organic waste recovery</strong> feeding back into regional food production</li>
            <li><strong class="text-forest-800">Scalable agrihood innovation framework</strong> that can be replicated globally</li>
          </ol>
        </div>
        <div class="min-h-[280px]"><Image src={omFood} alt="A food hall and market." widths={[993]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10 md:order-2">
          <h3 class="font-display text-2xl text-forest-700">Landscape Intelligence: Designing Nature as Infrastructure</h3>
          <p class="prose-body mt-3 !text-[15px]">Treating landscape as living infrastructure: integrated ecology, climate adaptation, social systems, and public health. Designing with nature's logic, not tacking nature onto development.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">"City-Nature" as foundational infrastructure</strong>: ecology woven into streets, plazas, and open space as a working system</li>
            <li><strong class="text-forest-800">Climate and water performance by design</strong>: cooling, stormwater, and microclimate regulation through living landscapes</li>
            <li><strong class="text-forest-800">Health, biodiversity, and public life integrated</strong>: landscapes that support well-being, habitat, and social connection at once</li>
            <li><strong class="text-forest-800">Adaptive and evolving open space</strong>: flexible landscapes that change with use, seasons, and the district's growth</li>
          </ol>
        </div>
        <div class="min-h-[280px] md:order-1"><Image src={omLandscape} alt="Nature woven through the district." widths={[787]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>

      <div class="mt-6 grid overflow-hidden rounded-md border border-stone-100 bg-cream-50 md:grid-cols-2">
        <div class="p-8 md:p-10">
          <h3 class="font-display text-2xl text-forest-700">Women-First, Family-First, and Aging-In-Place Design</h3>
          <p class="prose-body mt-3 !text-[15px]">Communities designed around the daily realities of women, children, and aging adults consistently outperform conventional development on health, safety, stability, and long-term value. A women-first lens creates places that work better for everyone.</p>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed text-stone-700">
            <li><strong class="text-forest-800">Aging-in-place housing and services</strong> supporting independence, dignity, and reduced healthcare burden over time</li>
            <li><strong class="text-forest-800">Child-centered public realm</strong> with safe mobility, nature-based play, and everyday supervision through active streets</li>
            <li><strong class="text-forest-800">Women-first safety, access, and care design</strong> shown to increase walkability, retail vitality, and neighborhood stability</li>
            <li><strong class="text-forest-800">Intergenerational community fabric</strong> proven to reduce isolation, improve mental health, and increase long-term residency</li>
          </ol>
        </div>
        <div class="min-h-[280px]"><Image src={omWomen} alt="A community designed around women and families." widths={[1256]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Oregon</p>
        <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">An hour from everything worth loving.</h2>
        <p class="prose-body mt-5">The first neighborhood is rising in one of the most livable and productive regions in the country: world-class nature in every direction, a growing innovation economy, and an under-recognized quality of life. Portland and its international airport within easy reach; the coast, the mountains, and wine country within about an hour. Oregon ranked first in the nation for inbound movers in 2025.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <Figure src={oregonCoast} alt="The Oregon Coast." cap="The Oregon Coast, an easy day trip." aspect="aspect-[4/3]" widths={[500, 900, 1400]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={silverFalls} alt="A waterfall in an Oregon forest." cap="Forests, waterfalls, and mountains in every direction." aspect="aspect-[4/3]" widths={[500, 900, 1400]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={vineyard} alt="Oregon vineyards." cap="Surrounded by vineyards, farms, and food." aspect="aspect-[4/3]" widths={[500, 900, 1400]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={oregonBiking} alt="Cyclists on an Oregon road." cap="Four-season outdoor living." aspect="aspect-[4/3]" widths={[500, 900, 1400]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
      </div>
      <p class="prose-body mt-10 max-w-3xl">The feeling of all this lives in <a href="/neighborhood">a day here</a>, and the homes themselves at <a href="/homes">homes</a>.</p>
    </div>
  </section>

  <SubFooter />
</Layout>

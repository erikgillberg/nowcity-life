---
import Layout from '../layouts/Layout.astro';
import SubNav from '../components/SubNav.astro';
import SubFooter from '../components/SubFooter.astro';
import EarlyNote from '../components/EarlyNote.astro';
import { Image } from 'astro:assets';

import rowhouseStreet from '../assets/pages/rowhouse-street.jpg';
import rowhouseDusk from '../assets/pages/rowhouse-dusk.jpg';
import streetArch from '../assets/pages/street-arch.jpg';
import Figure from '../components/Figure.astro';
import { homePlans } from '../data/homePlans';
import pStudioA from '../assets/plans/01-courtyard-studio-living-sleeping.jpg';
import pStudioB from '../assets/plans/uv-studio.jpg';
import pOneCorner from '../assets/plans/uv-balcony.jpg';
import pLiveWork from '../assets/plans/uv-livework.jpg';
import pTwoCorner from '../assets/plans/uv-bedroom.jpg';
import pTwoThrough from '../assets/plans/uv-twobed.jpg';
import pThreeFam from '../assets/plans/03-two-bed-through-family-living.jpg';
import pColiving from '../assets/plans/04-coliving-common-kitchen.jpg';
import pTownhome from '../assets/plans/05-courtyard-townhome-stoop.jpg';
import uvRooftop from '../assets/plans/uv-rooftop.jpg';
import intBedroom2 from '../assets/pages/int-bedroom2.jpg';
import intDining from '../assets/pages/int-dining.jpg';
import intKitchen from '../assets/pages/int-kitchen.jpg';
import intBath from '../assets/pages/int-bath.jpg';
import intBalcony from '../assets/pages/int-balcony.jpg';
import intKids from '../assets/pages/int-kids.jpg';
import intColiving from '../assets/pages/int-coliving.jpg';
import intFlex from '../assets/pages/int-flex.jpg';
import stairLight from '../assets/pages/stair-light.jpg';
import blockCorner from '../assets/pages/block-corner.jpg';
import towerDusk from '../assets/pages/tower-dusk.jpg';
import scandiAerial from '../assets/pages/scandi-aerial.jpg';
import interiorDining from '../assets/pages/interior-dining.jpg';
import gardenBeds from '../assets/pages/afternoon-garden.jpg';

const description =
  'A catalog of healthy, attainable homes: factory-precise, light-filled, efficient, and designed for the neighborhoods they sit in.';

const planImages: Record<string, any> = {
  'studio-courtyard': pStudioA, 'studio-alcove': pStudioB, 'one-corner': pOneCorner,
  'one-live-work': pLiveWork, 'two-corner': pTwoCorner, 'two-through': pTwoThrough,
  'three-family': pThreeFam, 'coliving-courtyard': pColiving, 'base-townhome': pTownhome,
};
const fitLabel: Record<string, string> = {
  solo: 'Living solo', couple: 'Two of us', family: 'With kids',
  work: 'Working from home', shared: 'Sharing with others',
};
const fitFilters = [
  ['all', 'Anyone'], ['solo', 'Living solo'], ['couple', 'Two of us'], ['family', 'With kids'],
  ['work', 'Working from home'], ['shared', 'Sharing with others'],
];
---

<Layout title="Homes" description={description}>
  <SubNav current="/homes" />

  <section class="pt-12 md:pt-16">
    <div class="container-wide">
      <div class="overflow-hidden rounded-md shadow-sm">
        <Image src={rowhouseStreet} alt="A street of warm rowhouses with front stoops." widths={[800, 1376]} sizes="(min-width: 1024px) 1100px, 100vw" class="h-auto w-full object-cover" loading="eager" />
      </div>
      <div class="mt-10 max-w-3xl">
        <p class="eyebrow">Homes</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-forest-700 md:text-5xl">Healthy, beautiful, attainable. Pick all three.</h1>
        <p class="lede mt-6">Healthy, light-filled homes at honest prices, designed with the people who plan to live in them. Here is where the designs stand today, and how to help shape them.</p>
        <EarlyNote title="Study options, not listings." body="Everything here is early and evolving: sizes are planning ranges, the home mix is still being decided, and we are not selling or leasing yet. Your input genuinely shapes which homes get designed further." />
        <p class="prose-body mt-5 !text-[15px]"><a href="#attainable">Worried this looks expensive?</a> So are we, and we take that question seriously further down the page.</p>
      </div>
    </div>
  </section>


  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">Inside</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700">Light, air, quiet, warmth.</h2>
        <p class="prose-body mt-4">Concept interiors from the current design work. Different rooms, one consistent set of decisions.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <Figure src={intKitchen} alt="A parent and child cooking in a daylight-filled kitchen." cap="A kitchen the day starts in." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={intBalcony} alt="A balcony with morning coffee overlooking the courtyard." cap="Morning coffee, courtyard side." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={intDining} alt="A dining room with a wooden table and generous windows." cap="A table the day gathers around." aspect="aspect-[3/2]" widths={[500, 1330]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={intBedroom2} alt="A bedroom with a person reading on the bed." cap="Quiet, by design." aspect="aspect-[3/2]" widths={[500, 1326]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={intKids} alt="A kids' bedroom with a bunk nook and window seat." cap="A room worth growing up in." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        <Figure src={intFlex} alt="A flexible room set up as a home office, ready to become a nursery." cap="The office that becomes the nursery." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section id="types" class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Type Library</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">Which home would fit your life?</h2>
        <p class="prose-body mt-4">Nine home types are under study, from studios to townhomes. Tell us who is moving in and see the ones we are designing for that household. Then tell us what we got wrong.</p>
      </div>

      <div class="mt-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Who is moving in?</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {fitFilters.map(([value, lab]) => (
            <button type="button" data-ffit={value} class={`rounded-full border px-4 py-2 text-sm font-medium transition-colors ${value === 'all' ? 'border-forest-700 bg-forest-700 text-cream-50' : 'border-stone-200 bg-white text-stone-600 hover:border-forest-700/40'}`}>{lab}</button>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 pt-4">
          <p id="plan-readout" class="font-display text-lg text-forest-700"></p>
          <p class="hidden text-xs text-stone-500 md:block">Scroll the row to browse →</p>
        </div>
      </div>

      <div id="plan-rail" class="-mx-6 mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-4 lg:mx-0 lg:px-0">
        {homePlans.map((plan) => (
          <article class="plan-card w-[300px] flex-none snap-start overflow-hidden rounded-md border border-stone-100 bg-white sm:w-[340px]" data-fit={plan.household.join(' ')}>
            <Figure src={planImages[plan.id]} alt={`${plan.title} concept interior`} cap="Concept render, early design study." aspect="aspect-[4/3]" widths={[400, 800, 1536]} sizes="340px" />
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <p class="eyebrow !text-[10px]">{plan.status}</p>
                <span class="whitespace-nowrap rounded-full bg-cream-100 px-2 py-0.5 text-[10px] font-medium text-forest-600">{plan.type}</span>
              </div>
              <h3 class="mt-1 font-display text-xl text-forest-700">{plan.title}</h3>
              <p class="mt-1 text-sm text-stone-600">{plan.areaRange} · {plan.beds} · {plan.baths}</p>
              <p class="mt-3 text-sm leading-relaxed text-stone-700">{plan.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {plan.household.map((f) => <span class="fit-chip rounded-full border border-stone-200 px-2.5 py-1 text-[11px] text-stone-600" data-fitchip={f}>{fitLabel[f]}</span>)}
              </div>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {plan.checks.map((check) => <span class="rounded bg-cream-100 px-2 py-1 text-[11px] font-medium text-forest-600">{check}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p id="plan-empty" class="mt-4 hidden rounded-md border border-stone-200 bg-white p-6 text-sm text-stone-600">Nothing in the current studies matches that, which is genuinely useful for us to know. Tell us what you were looking for in the form below.</p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <Figure src={uvRooftop} alt="A shared rooftop room opening onto a planted terrace." cap="Shared spaces count too: the rooftop room and terrace. Concept render." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} />
        <EarlyNote variant="compact" title="No rents or availability yet." body="These are study options rather than listings. Sizes are planning ranges, the mix is still being decided, and the fastest way to influence it is to tell us what fits." cta={false} />
      </div>
    </div>
  </section>

  <section id="design-system" class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Design System</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">Nordic light, Japanese order, Northwest materials.</h2>
        <p class="prose-body mt-4">Every project worth its salt has a design language it can name. Culdesac married a Mediterranean village to desert urbanism. Living Places Copenhagen built everything on five principles. Ours comes from three traditions that already agree with each other, adapted to a valley that rains for half the year.</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6">
          <p class="eyebrow !text-[10px]">Lineage one</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Scandinavian</h3>
          <p class="prose-body mt-3 !text-[15px]">A discipline about daylight, developed by people who get very little of it in winter, plus the Danish insistence that a home should feel like a warm embrace at the end of a dark day. Light is planned first; comfort is not an upgrade.</p>
          <p class="mt-3 text-[13px] text-stone-500">What we take: tall windows, pale reflective surfaces, layered lamplight, the social ground floor.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6">
          <p class="eyebrow !text-[10px]">Lineage two</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Japanese</h3>
          <p class="prose-body mt-3 !text-[15px]">The ordering system: a repeated structural module, storage built into the walls, a proper threshold between outside and in, and the practice of borrowing the garden as part of the room. Restraint here is not austerity, it is editing.</p>
          <p class="mt-3 text-[13px] text-stone-500">What we take: the module, the built-in wall, the entry threshold, borrowed scenery.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-cream-50 p-6">
          <p class="eyebrow !text-[10px]">Lineage three</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Pacific Northwest</h3>
          <p class="prose-body mt-3 !text-[15px]">The region's own modern tradition: local timber left visible, post-and-beam simplicity, deep overhangs against the rain, and glass sized for gray days. It is the least precious of the three, and the reason this will read as an Oregon place rather than an import.</p>
          <p class="mt-3 text-[13px] text-stone-500">What we take: exposed structure, honest local materials, weather-smart edges.</p>
        </div>
      </div>

      <div class="mt-12 max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">What the three produce together</p>
        <h3 class="mt-2 font-display text-2xl text-forest-700">Seven moves you can look for in every render.</h3>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">1. The light plan comes first</h4>
          <p class="prose-body mt-2 !text-[15px]">Rooms people live in take the window wall; bathrooms, storage, and circulation take the dark middle. Windows run tall and close to the ceiling, because the top of a window throws light deepest into a room.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">2. One module, many homes</h4>
          <p class="prose-body mt-2 !text-[15px]">A single structural bay repeats across the block, and homes are assembled from it. This is the Japanese discipline doing economic work: repetition is what lets us buy better windows, better walls, and better details than a one-off could afford.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">3. A real threshold at the door</h4>
          <p class="prose-body mt-2 !text-[15px]">A place to land: shoes off, coat down, bags parked, before the home proper begins. Small, cheap, and the single most missed detail in American apartments.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">4. Borrowed scenery</h4>
          <p class="prose-body mt-2 !text-[15px]">Every window is composed on something green and shared, so the room ends at the trees rather than at the glass. A modest home feels generous when its view is doing part of the work.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">5. Storage is built, not bought</h4>
          <p class="prose-body mt-2 !text-[15px]">Full-height joinery at the entry, in the kitchen, beside the bed. Designed in, it costs a fraction of furniture solving the same problem, and it is why a compact home stays calm instead of turning cluttered.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <h4 class="font-display text-lg text-forest-700">6. Structure shown, wear welcomed</h4>
          <p class="prose-body mt-2 !text-[15px]">Beams and honest surfaces stay visible. Trim and soffits are money spent hiding a building from you, and materials chosen to age (wood, stone, linen, clay) look better in year ten than year one.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6 md:col-span-2">
          <h4 class="font-display text-lg text-forest-700">7. Quiet is a material decision</h4>
          <p class="prose-body mt-2 !text-[15px]">Thick, well-sealed walls, quality windows, and soft surfaces that absorb sound. The same choices that keep the street out hold the heat in and keep the bill small, which is how comfort, calm, and cost end up being one decision instead of three.</p>
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">How it changes across the neighborhood</p>
          <h3 class="mt-2 font-display text-2xl text-forest-700">Calm homes, warm commons, expressive civic.</h3>
          <p class="prose-body mt-4">The language is not applied at one volume everywhere. Homes are the quietest: restrained, neutral, built to be a backdrop for your life. Shared rooms turn the warmth up, with richer materials and more color, because they are where the neighborhood performs. The civic buildings, the market and the workshop, are allowed real character. It is the same grammar, spoken at three different volumes.</p>
        </div>
        <Figure src={intFlex} alt="A flexible room with built-in storage and daylight." cap="Home volume: quiet enough to be a backdrop. Concept render." aspect="aspect-[3/2]" widths={[500, 1000, 1536]} />
      </div>


      <p class="prose-body mt-10 max-w-3xl">Materials and finishes are still being selected, and we will show them when the choices are real rather than illustrative. The intent is settled, though: the palette stays quiet, because the home is the setting and your things, your people, and the green outside supply the color.</p>
      <p class="prose-body mt-4 max-w-3xl">How homes get built this way at honest prices is the other half of the story: it is further down this page, and on <a href="/how-we-build">How We Build</a>.</p>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide grid items-center gap-10 md:grid-cols-2">
      <div class="md:order-2 overflow-hidden rounded-md shadow-sm"><Image src={streetArch} alt="A green arch over a neighborhood street with shops, bikes, and a dog park." widths={[700, 1376]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full object-cover" /></div>
      <div class="md:order-1">
        <p class="eyebrow">Attainable, honestly</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700">Smaller, smarter, and yours.</h2>
        <p class="prose-body mt-4">Attainability is a design decision, not a discount. Efficient layouts that live larger than their square footage, because the neighborhood itself is part of your home: the market is your pantry, the courtyard is your second living room, the street is where your kids play. And we are building ownership paths so the people who live here can hold a piece of the place.</p>
      </div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Catalog</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">For sale and for rent. Pick your shape.</h2>
        <p class="prose-body mt-4">We are designing these now, with input from the people who plan to live in them, and building custom home designer tools so you can shape your own. Nothing below is final. That is the point: tell us what you would actually want.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={rowhouseStreet} alt="Timber townhomes with stoops." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">To own</span><h3 class="mt-1 font-display text-lg text-forest-700">Townhomes</h3><p class="mt-2 text-sm text-stone-700">Front doors on the street, stoops, two to three bedrooms, and a block that knows your name.</p></figcaption>
        </figure>
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={blockCorner} alt="A mid-rise corner building with ground-floor life." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">To rent</span><h3 class="mt-1 font-display text-lg text-forest-700">Apartments &amp; lofts</h3><p class="mt-2 text-sm text-stone-700">Studios to family-sized, light-filled and efficient, steps from the market and the courtyard.</p></figcaption>
        </figure>
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={scandiAerial} alt="A courtyard block from above." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">Rent or own</span><h3 class="mt-1 font-display text-lg text-forest-700">The Scandi Block</h3><p class="mt-2 text-sm text-stone-700">Courtyard living: a quiet garden heart, daily life at the edges, and the whole block as your backyard.</p></figcaption>
        </figure>
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={intColiving} alt="Residents cooking together around a shared kitchen and long table." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">To rent</span><h3 class="mt-1 font-display text-lg text-forest-700">Co-living</h3><p class="mt-2 text-sm text-stone-700">Private rooms, generous shared kitchens and long tables, priced for starting out and built for company.</p></figcaption>
        </figure>
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={gardenBeds} alt="Garden beds between homes with several generations tending them." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">Flexible</span><h3 class="mt-1 font-display text-lg text-forest-700">Multigenerational</h3><p class="mt-2 text-sm text-stone-700">Homes that flex as families grow, age, and come back together: paired flats, in-law suites, shared courtyards.</p></figcaption>
        </figure>
        <figure class="rounded-md border border-stone-100 bg-white overflow-hidden">
          <Image src={towerDusk} alt="A slender residential tower at dusk." widths={[600, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
          <figcaption class="p-5"><span class="eyebrow !text-[10px]">An open question</span><h3 class="mt-1 font-display text-lg text-forest-700">The city tower</h3><p class="mt-2 text-sm text-stone-700">A taller idea we are testing: small footprint, big views, the district at your feet. Love it or hate it, we want to hear which.</p></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="homes-form" class="py-section">
    <div class="container-narrow">
      <p class="eyebrow">Demand first</p>
      <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">Tell us what you would want.</h2>
      <p class="prose-body mt-4">We form the community before the buildings. Reservations will lead construction the way orders lead production everywhere else, so your answer here is not a survey. It is the order book taking shape.</p>
      <form
        action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=5812d18a23&amp;f_id=0099bbe7f0"
        method="post"
        target="_blank"
        novalidate
        class="mt-8 grid gap-5"
      >
        <div>
          <label for="EMAIL" class="block text-sm font-medium text-forest-800">Email <span class="text-copper-400">*</span></label>
          <input id="EMAIL" name="EMAIL" type="email" required autocomplete="email" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
        </div>
        <div>
          <label for="FNAME" class="block text-sm font-medium text-forest-800">First name <span class="text-copper-400">*</span></label>
          <input id="FNAME" name="FNAME" type="text" required autocomplete="given-name" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
        </div>
        <div>
          <label for="LOCATION" class="block text-sm font-medium text-forest-800">Where would you want a Now City neighborhood?</label>
          <input id="LOCATION" name="LOCATION" type="text" placeholder="city, metro, or ZIP" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 placeholder:text-stone-400 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
        </div>
        <fieldset>
          <legend class="block text-sm font-medium text-forest-800">If a home opened up, what would catch your eye?</legend>
          <p class="mt-1 text-xs text-stone-500">Optional. Pick anything that fits.</p>

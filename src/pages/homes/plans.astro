---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';
import SubFooter from '../../components/SubFooter.astro';
import ConceptPlanSvg from '../../components/ConceptPlanSvg.astro';
import Figure from '../../components/Figure.astro';
import { homePlans } from '../../data/homePlans';

import rStudio from '../../assets/plans/01-courtyard-studio-living-sleeping.jpg';
import rLiveWork from '../../assets/plans/02-live-work-one-bed-flex.jpg';
import rTwoBed from '../../assets/plans/03-two-bed-through-family-living.jpg';
import rColiving from '../../assets/plans/04-coliving-common-kitchen.jpg';
import rTownhome from '../../assets/plans/05-courtyard-townhome-stoop.jpg';

const description =
  'An illustrative home type library for a walkable courtyard block: pre-development design studies, open to your input. No rents or availability yet.';

const sizeFilters = [
  ['all', 'All homes'], ['studio', 'Studios'], ['one-bed', '1 bed'], ['two-bed', '2 bed'],
  ['three-bed', '3 bed'], ['shared', 'Shared'], ['townhome', 'Townhome'],
];
const fitFilters = [
  ['all', 'Any household'], ['solo', 'Solo'], ['couple', 'Couple'], ['family', 'Family'],
  ['work', 'Work-from-home'], ['shared', 'Shared living'],
];
const bedWeight = (size: string) =>
  size === 'studio' ? 0 : size === 'one-bed' ? 1 : size === 'two-bed' ? 2 : size === 'three-bed' ? 3 : size === 'shared' ? 4 : 5;

const renders = [
  { img: rStudio, cap: 'The Courtyard Studio, as it could feel. Concept render, early design study.' },
  { img: rLiveWork, cap: 'The Live / Work One-Bed flex corner. Concept render, early design study.' },
  { img: rTwoBed, cap: 'A Two-Bed Through Home living room. Concept render, early design study.' },
  { img: rColiving, cap: 'The Co-Living common kitchen. Concept render, early design study.' },
  { img: rTownhome, cap: 'The Courtyard Townhome, stoop side. Concept render, early design study.' },
];
---

<Layout title="Illustrative Home Plans" description={description}>
  <SubNav current="/homes" />

  <section class="pt-12 md:pt-16">
    <div class="container-wide grid items-start gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="eyebrow">Homes · The Plan Library</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-forest-700 md:text-5xl">Illustrative home plans for a walkable courtyard block.</h1>
        <p class="lede mt-6">A pre-development home type library: transparent about what is still evolving, specific enough to show how light, storage, flexibility, and shared landings shape each home.</p>
      </div>
      <aside class="rounded-md border border-copper-400/40 bg-white p-6" aria-label="Project status">
        <p class="eyebrow !text-[10px]">Pre-development status</p>
        <p class="mt-2 font-display text-xl text-forest-700">No rents or availability yet.</p>
        <p class="prose-body mt-3 !text-sm">These plans are design studies. They help future residents compare home types and tell us what would fit their lives. Everything here can change, and your input is part of how it changes.</p>
      </aside>
    </div>
  </section>

  <section class="py-10">
    <div class="container-wide grid gap-4 md:grid-cols-3">
      <div class="rounded-md border border-stone-100 bg-cream-50 p-5"><p class="font-display text-forest-700">Daylight first</p><p class="mt-1 text-sm text-stone-600">Habitable rooms face the courtyard, street, or corner.</p></div>
      <div class="rounded-md border border-stone-100 bg-cream-50 p-5"><p class="font-display text-forest-700">Courtyard urbanism</p><p class="mt-1 text-sm text-stone-600">Plans assume shared gardens, short landings, and useful thresholds.</p></div>
      <div class="rounded-md border border-stone-100 bg-cream-50 p-5"><p class="font-display text-forest-700">Illustrative, always</p><p class="mt-1 text-sm text-stone-600">Areas are planning ranges, and nothing here is final inventory.</p></div>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide grid items-start gap-10 lg:grid-cols-[240px_1fr]">
      <aside class="lg:sticky lg:top-6" aria-label="Home plan filters">
        <p class="eyebrow !text-[10px]">Refine home types</p>
        <div class="mt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Home size</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {sizeFilters.map(([value, lab]) => (
              <button type="button" data-fsize={value} class={`plan-filter rounded-full border px-3 py-1.5 text-xs font-medium transition-colors ${value === 'all' ? 'border-forest-700 bg-forest-700 text-cream-50' : 'border-stone-200 bg-white text-stone-600 hover:border-forest-700/40'}`}>{lab}</button>
            ))}
          </div>
        </div>
        <div class="mt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Household fit</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {fitFilters.map(([value, lab]) => (
              <button type="button" data-ffit={value} class={`plan-filter rounded-full border px-3 py-1.5 text-xs font-medium transition-colors ${value === 'all' ? 'border-forest-700 bg-forest-700 text-cream-50' : 'border-stone-200 bg-white text-stone-600 hover:border-forest-700/40'}`}>{lab}</button>
            ))}
          </div>
        </div>
        <label class="mt-5 block text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Sort
          <select id="plan-sort" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-sm font-normal normal-case tracking-normal text-forest-800">
            <option value="small-large">Area: small to large</option>
            <option value="large-small">Area: large to small</option>
            <option value="bedrooms">Bedrooms</option>
          </select>
        </label>
      </aside>

      <div>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow !text-[10px]">Home type library</p>
            <h2 class="mt-1 font-display text-2xl text-forest-700"><span id="plan-count">{homePlans.length}</span> illustrative plans</h2>
          </div>
          <p id="plan-range" class="rounded-full border border-stone-200 bg-white px-3 py-1.5 text-xs text-stone-600"></p>
        </div>
        <div id="plan-grid" class="mt-6 grid gap-6 md:grid-cols-2">
          {homePlans.map((plan) => (
            <article
              class="plan-card flex flex-col rounded-md border border-stone-100 bg-white"
              data-size={plan.size}
              data-fit={plan.household.join(' ')}
              data-area={plan.areaSqFt}
              data-bedweight={bedWeight(plan.size)}
            >
              <div class="rounded-t-md border-b border-stone-100 bg-[#FBFAF6] p-4">
                <ConceptPlanSvg plan={plan} />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="eyebrow !text-[10px]">{plan.status}</p>
                <h3 class="mt-1 font-display text-xl text-forest-700">{plan.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-stone-700">{plan.summary}</p>
                <div class="mt-3 flex flex-wrap gap-2 text-xs">
                  <span class="rounded-full border border-stone-200 px-2.5 py-1 text-stone-600">{plan.beds}</span>
                  <span class="rounded-full border border-stone-200 px-2.5 py-1 text-stone-600">{plan.baths}</span>
                  <span class="rounded-full border border-stone-200 px-2.5 py-1 text-stone-600">{plan.areaRange}</span>
                </div>
                <p class="mt-3 text-[13px] leading-relaxed text-stone-500">{plan.rationale}</p>
                <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
                  {plan.checks.map((check) => <span class="rounded bg-cream-100 px-2 py-1 text-[11px] font-medium text-forest-600">{check}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
        <p id="plan-empty" class="mt-6 hidden rounded-md border border-stone-200 bg-white p-6 text-sm text-stone-600">No study options match that combination yet, which is useful for us to know. Tell us what you were looking for in the form below.</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">How They Could Feel</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700">Concept renders for five of the studies.</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {renders.map(({ img, cap }) => (
          <Figure src={img} alt={cap} cap={cap} aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
        ))}
      </div>
    </div>
  </section>

  <section id="share-fit" class="py-section bg-cream-50">
    <div class="container-narrow">
      <p class="eyebrow">Help Shape the Home Mix</p>
      <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">Instead of choosing from available units, tell us what would actually fit your life.</h2>
      <p class="prose-body mt-4">This is the part that matters most right now. Your answers guide which home types get designed further, and in what proportions. It takes about a minute, and it obligates you to nothing.</p>
      <form
        id="fit-form"
        action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=5812d18a23&amp;f_id=0099bbe7f0"
        method="post"
        target="_blank"
        novalidate
        class="mt-8 grid gap-5"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="FNAME" class="block text-sm font-medium text-forest-800">First name <span class="text-copper-400">*</span></label>
            <input id="FNAME" name="FNAME" type="text" required class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
          </div>
          <div>
            <label for="EMAIL" class="block text-sm font-medium text-forest-800">Email <span class="text-copper-400">*</span></label>
            <input id="EMAIL" name="EMAIL" type="email" required class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="f-household" class="block text-sm font-medium text-forest-800">Household size</label>
            <select id="f-household" data-pref="Household" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Just me</option><option>Two of us</option><option>Three or four</option><option>Five or more</option><option>It varies</option></select>
          </div>
          <div>
            <label for="f-type" class="block text-sm font-medium text-forest-800">Home type that fits best</label>
            <select id="f-type" data-pref="Preferred home type" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Studio</option><option>One-bedroom</option><option>Two-bedroom</option><option>Three-bedroom</option><option>Townhome</option><option>Co-living / shared</option><option>Not sure yet</option></select>
          </div>
          <div>
            <label for="f-budget" class="block text-sm font-medium text-forest-800">Monthly housing budget comfort</label>
            <select id="f-budget" data-pref="Budget comfort" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Under $1,500</option><option>$1,500 to $2,000</option><option>$2,000 to $2,800</option><option>Above $2,800</option><option>Rather share later</option></select>
          </div>
          <div>
            <label for="f-access" class="block text-sm font-medium text-forest-800">Accessibility needs</label>
            <select id="f-access" data-pref="Accessibility" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>None right now</option><option>Step-free access matters</option><option>Single-level living matters</option><option>Other, in notes below</option></select>
          </div>
          <div>
            <label for="f-storage" class="block text-sm font-medium text-forest-800">Storage needs</label>
            <select id="f-storage" data-pref="Storage" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Standard</option><option>Extra, please</option><option>Bikes and outdoor gear</option></select>
          </div>
          <div>
            <label for="f-pets" class="block text-sm font-medium text-forest-800">Pets</label>
            <select id="f-pets" data-pref="Pets" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>None</option><option>Cat(s)</option><option>Dog(s)</option><option>A few of each</option></select>
          </div>
          <div>
            <label for="f-wfh" class="block text-sm font-medium text-forest-800">Work from home</label>
            <select id="f-wfh" data-pref="Work from home" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Most days</option><option>Sometimes</option><option>Rarely</option></select>
          </div>
        </div>
        <fieldset>
          <legend class="block text-sm font-medium text-forest-800">Shared amenities you would actually use</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-3">
            {['Shared kitchen and long table', 'Courtyard gardens', 'Workshop / maker space', 'Fitness and sauna', 'Guest suite to book', 'Coworking room'].map((a) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2.5 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5"><input type="checkbox" data-prefcheck="Amenities" value={a} class="accent-forest-700" /> {a}</label>
            ))}
          </div>
        </fieldset>
        <div>
          <label for="f-notes" class="block text-sm font-medium text-forest-800">Anything else about your fit?</label>
          <textarea id="f-notes" rows="3" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"></textarea>
        </div>
        <input type="hidden" name="NOTES" id="NOTES" value="" />
        <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="b_88bfb2c8f34fdd20e85cce03f_5812d18a23" tabindex="-1" value="" /></div>
        <div class="mt-2">
          <button type="submit" class="btn-primary">Help shape the home mix</button>
          <p class="mt-3 text-xs text-stone-500">Preference capture, never a lease or reservation. Occasional updates, unsubscribe anytime. See our <a href="/privacy" class="text-forest-700">privacy policy &amp; disclaimers</a>.</p>
        </div>
      </form>
    </div>
  </section>

  <SubFooter />
</Layout>

<script>
  const state = { size: 'all', fit: 'all', sort: 'small-large' };
  const cards = Array.from(document.querySelectorAll('.plan-card'));
  const grid = document.getElementById('plan-grid');
  const countEl = document.getElementById('plan-count');
  const rangeEl = document.getElementById('plan-range');
  const emptyEl = document.getElementById('plan-empty');

  function activate(buttons, attr, value) {
    buttons.forEach((b) => {
      const on = b.dataset[attr] === value;
      b.classList.toggle('bg-forest-700', on);
      b.classList.toggle('text-cream-50', on);
      b.classList.toggle('border-forest-700', on);
      b.classList.toggle('bg-white', !on);
      b.classList.toggle('text-stone-600', !on);
      b.classList.toggle('border-stone-200', !on);
    });
  }
  const sizeBtns = Array.from(document.querySelectorAll('[data-fsize]'));
  const fitBtns = Array.from(document.querySelectorAll('[data-ffit]'));
  sizeBtns.forEach((b) => b.addEventListener('click', () => { state.size = b.dataset.fsize; activate(sizeBtns, 'fsize', state.size); apply(); }));
  fitBtns.forEach((b) => b.addEventListener('click', () => { state.fit = b.dataset.ffit; activate(fitBtns, 'ffit', state.fit); apply(); }));
  document.getElementById('plan-sort').addEventListener('change', (e) => { state.sort = e.target.value; apply(); });

  function apply() {
    const visible = [];
    cards.forEach((card) => {
      const sizeOk = state.size === 'all' || card.dataset.size === state.size;
      const fitOk = state.fit === 'all' || card.dataset.fit.split(' ').includes(state.fit);
      const show = sizeOk && fitOk;
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    });
    visible.sort((a, b) => {
      if (state.sort === 'large-small') return +b.dataset.area - +a.dataset.area;
      if (state.sort === 'bedrooms') return +a.dataset.bedweight - +b.dataset.bedweight;
      return +a.dataset.area - +b.dataset.area;
    });
    visible.forEach((card) => grid.appendChild(card));
    countEl.textContent = String(visible.length);
    if (visible.length) {
      const areas = visible.map((c) => +c.dataset.area);
      rangeEl.textContent = `${Math.min(...areas)}-${Math.max(...areas)} sq ft, planning ranges`;
      rangeEl.style.display = '';
      emptyEl.classList.add('hidden');
    } else {
      rangeEl.style.display = 'none';
      emptyEl.classList.remove('hidden');
    }
  }
  apply();

  document.getElementById('fit-form').addEventListener('submit', () => {
    const parts = [];
    document.querySelectorAll('[data-pref]').forEach((el) => { if (el.value) parts.push(`${el.dataset.pref}: ${el.value}`); });
    const checked = Array.from(document.querySelectorAll('[data-prefcheck]:checked')).map((el) => el.value);
    if (checked.length) parts.push(`Amenities: ${checked.join(', ')}`);
    const notes = document.getElementById('f-notes').value.trim();
    if (notes) parts.push(`Notes: ${notes}`);
    document.getElementById('NOTES').value = `[Home plans fit] ${parts.join(' | ')}`;
  });
</script>

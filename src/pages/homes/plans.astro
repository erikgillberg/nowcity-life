---
import Layout from '../../layouts/Layout.astro';
import SubNav from '../../components/SubNav.astro';
import SubFooter from '../../components/SubFooter.astro';
import Figure from '../../components/Figure.astro';
import { homePlans } from '../../data/homePlans';

import rStudio from '../../assets/plans/01-courtyard-studio-living-sleeping.jpg';
import rLiveWork from '../../assets/plans/02-live-work-one-bed-flex.jpg';
import rTwoBed from '../../assets/plans/03-two-bed-through-family-living.jpg';
import rColiving from '../../assets/plans/04-coliving-common-kitchen.jpg';
import rTownhome from '../../assets/plans/05-courtyard-townhome-stoop.jpg';

const description =
  'A home type library for a walkable courtyard block: pre-development study options, open to your input. No rents or availability yet.';

const sizeFilters = [
  ['all', 'All homes'], ['studio', 'Studios'], ['one-bed', '1 bed'], ['two-bed', '2 bed'],
  ['three-bed', '3 bed'], ['shared', 'Shared'], ['townhome', 'Townhome'],
];
const fitFilters = [
  ['all', 'Anyone'], ['solo', 'Living solo'], ['couple', 'Two of us'], ['family', 'With kids'],
  ['work', 'Working from home'], ['shared', 'Sharing with others'],
];
const bedWeight = (size: string) =>
  size === 'studio' ? 0 : size === 'one-bed' ? 1 : size === 'two-bed' ? 2 : size === 'three-bed' ? 3 : size === 'shared' ? 4 : 5;

const minArea = Math.min(...homePlans.map((p) => p.areaSqFt));
const maxArea = Math.max(...homePlans.map((p) => p.areaSqFt));
const pct = (a: number) => Math.round(((a - minArea) / (maxArea - minArea)) * 100);

const fitLabel: Record<string, string> = {
  solo: 'Living solo', couple: 'Two of us', family: 'With kids',
  work: 'Working from home', shared: 'Sharing with others',
};

const renders = [
  { img: rStudio, cap: 'The Courtyard Studio, as it could feel. Concept render, early design study.' },
  { img: rLiveWork, cap: 'The Live / Work One-Bed flex corner. Concept render, early design study.' },
  { img: rTwoBed, cap: 'A Two-Bed Through Home living room. Concept render, early design study.' },
  { img: rColiving, cap: 'The Co-Living common kitchen. Concept render, early design study.' },
  { img: rTownhome, cap: 'The Courtyard Townhome, stoop side. Concept render, early design study.' },
];
---

<Layout title="Home Types" description={description}>
  <SubNav current="/homes" />

  <section class="pt-12 md:pt-16">
    <div class="container-wide grid items-start gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="eyebrow">Homes · The Type Library</p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-forest-700 md:text-5xl">Which home would fit your life?</h1>
        <p class="lede mt-6">Tell us who is moving in and what matters, and we will show the home types we are studying for them. Then tell us what we got wrong.</p>
      </div>
      <aside class="rounded-md border border-copper-400/40 bg-white p-6" aria-label="Project status">
        <p class="eyebrow !text-[10px]">Setting expectations</p>
        <p class="mt-2 font-display text-xl text-forest-700">No rents or availability yet.</p>
        <p class="prose-body mt-3 !text-sm">These are study options, not listings. Sizes are planning ranges, the mix is still being decided, and your answers genuinely shape which homes get designed further.</p>
      </aside>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="rounded-md border border-stone-100 bg-cream-50 p-6 md:p-8">
        <p class="eyebrow !text-[10px]">Start here</p>
        <h2 class="mt-2 font-display text-2xl text-forest-700">Who is moving in?</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {fitFilters.map(([value, lab]) => (
            <button type="button" data-ffit={value} class={`plan-filter rounded-full border px-4 py-2 text-sm font-medium transition-colors ${value === 'all' ? 'border-forest-700 bg-forest-700 text-cream-50' : 'border-stone-200 bg-white text-stone-600 hover:border-forest-700/40'}`}>{lab}</button>
          ))}
        </div>

        <p class="mt-7 text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Narrow by size, if you like</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {sizeFilters.map(([value, lab]) => (
            <button type="button" data-fsize={value} class={`plan-filter rounded-full border px-3.5 py-1.5 text-xs font-medium transition-colors ${value === 'all' ? 'border-forest-700 bg-forest-700 text-cream-50' : 'border-stone-200 bg-white text-stone-600 hover:border-forest-700/40'}`}>{lab}</button>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-stone-200 pt-5">
          <p id="plan-readout" class="font-display text-lg text-forest-700"></p>
          <label class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">Sort
            <select id="plan-sort" class="ml-2 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm font-normal normal-case tracking-normal text-forest-800">
              <option value="small-large">Smallest first</option>
              <option value="large-small">Largest first</option>
              <option value="bedrooms">By bedrooms</option>
            </select>
          </label>
        </div>
      </div>

      <div id="plan-grid" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {homePlans.map((plan) => (
          <article
            class="plan-card flex flex-col rounded-md border border-stone-100 bg-white p-6"
            data-size={plan.size}
            data-fit={plan.household.join(' ')}
            data-area={plan.areaSqFt}
            data-bedweight={bedWeight(plan.size)}
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="eyebrow !text-[10px]">{plan.status}</p>
                <h3 class="mt-1 font-display text-xl text-forest-700">{plan.title}</h3>
              </div>
              <span class="whitespace-nowrap rounded-full bg-cream-100 px-2.5 py-1 text-[11px] font-medium text-forest-600">{plan.type}</span>
            </div>

            <div class="mt-4">
              <div class="flex items-baseline justify-between text-[11px] uppercase tracking-[0.1em] text-stone-500">
                <span>Compact</span><span>Roomy</span>
              </div>
              <div class="mt-1.5 h-1.5 w-full rounded-full bg-cream-200">
                <div class="h-1.5 rounded-full bg-sage-300" style={`width:${Math.max(pct(plan.areaSqFt), 6)}%`}></div>
              </div>
              <p class="mt-2 text-sm text-stone-600">{plan.areaRange} · {plan.beds} · {plan.baths}</p>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-stone-700">{plan.summary}</p>

            <div class="mt-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-stone-500">Studied for</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {plan.household.map((f) => <span class="fit-chip rounded-full border border-stone-200 px-2.5 py-1 text-[11px] text-stone-600" data-fitchip={f}>{fitLabel[f]}</span>)}
              </div>
            </div>

            <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
              {plan.checks.map((check) => <span class="rounded bg-cream-100 px-2 py-1 text-[11px] font-medium text-forest-600">{check}</span>)}
            </div>
          </article>
        ))}
      </div>
      <p id="plan-empty" class="mt-6 hidden rounded-md border border-stone-200 bg-white p-6 text-sm text-stone-600">Nothing in the current studies matches that combination, which is genuinely useful for us to know. Tell us what you were looking for in the form below.</p>
    </div>
  </section>

  <section class="py-section bg-cream-50">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">The Honest Part</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">"This all looks expensive."</h2>
        <div class="prose-body mt-5">
          <p>We hear this often, and it is a fair reaction. Renderings like these usually introduce homes most people cannot afford, and plenty of projects have promised otherwise and not delivered. We share the concern, and we would rather name it than decorate around it.</p>
          <p>So here is the honest version: attainability is not something we sprinkle on at the end. It is the hardest problem in the project, and it is the one we have organized the company around. Four things have to work together, and none of them is a slogan.</p>
        </div>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <p class="eyebrow !text-[10px]">Lever one</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Design that spends where it shows</h3>
          <p class="prose-body mt-3 !text-[15px]">Efficient plans, simple structure, and repeated details, so the budget goes into daylight, air, quiet, and durability rather than square footage you pay for and rarely use. Smaller homes only work when they are genuinely well designed, so that is where the design effort concentrates.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <p class="eyebrow !text-[10px]">Lever two</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Building the same thing more than once</h3>
          <p class="prose-body mt-3 !text-[15px]">Most homes are built as one-offs, and the industry pays for that in time, waste, and rework. Repeating a small number of well-tested home types, with as much built under a roof as makes sense, is how quality goes up while cost comes down. It works when there is committed demand, which is exactly why we are asking you now instead of later.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <p class="eyebrow !text-[10px]">Lever three</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">The neighborhood carries some of the home</h3>
          <p class="prose-body mt-3 !text-[15px]">A courtyard, a market, a workshop, a guest room you can book: shared things you would otherwise pay for privately, or go without. Sharing them well is what lets a modest home live much larger, and it is why we design the block and the home together.</p>
        </div>
        <div class="rounded-md border border-stone-100 bg-white p-6">
          <p class="eyebrow !text-[10px]">Lever four</p>
          <h3 class="mt-1 font-display text-xl text-forest-700">Patient money, and lower bills</h3>
          <p class="prose-body mt-3 !text-[15px]">Capital that expects returns over decades rather than a quick exit changes what a home can cost. Add energy bills engineered down and a life that needs fewer car trips, and the monthly math looks different from the sticker alone. We are building the ownership structures for this in the open, and we will publish what we learn.</p>
        </div>
      </div>

      <div class="mt-8 max-w-3xl rounded-md border border-copper-400/40 bg-white p-6">
        <p class="prose-body !text-[15px]">What we will not do is give you a number we cannot stand behind yet. Land, financing, and construction costs are still moving, and any price quoted today would be marketing rather than information. What we can promise: a real range as soon as we have one we believe, published to this list first, along with the reasoning behind it. If we cannot make attainable work here, we would rather tell you that than quietly build something else.</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow">How They Could Feel</p>
        <h2 class="mt-3 font-display text-3xl text-forest-700">Concept renders for five of the studies.</h2>
        <p class="prose-body mt-4">Early design studies, not final designs. The materials shown are chosen for how they age and perform, and every one of them is still under review for cost as well as quality.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {renders.map(({ img, cap }) => (
          <Figure src={img} alt={cap} cap={cap} aspect="aspect-[3/2]" widths={[500, 1000, 1536]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
        ))}
      </div>
    </div>
  </section>

  <section id="share-fit" class="py-section bg-cream-50">
    <div class="container-narrow">
      <p class="eyebrow">Help Shape the Home Mix</p>
      <h2 class="mt-3 font-display text-3xl text-forest-700 md:text-4xl">Instead of choosing from available units, tell us what would actually fit your life.</h2>
      <p class="prose-body mt-4">This is the part that matters most right now. Your answers guide which home types get designed further, and in what proportions. It takes about a minute, and it obligates you to nothing.</p>
      <form
        id="fit-form"
        action="https://nowcitylabs.us19.list-manage.com/subscribe/post?u=88bfb2c8f34fdd20e85cce03f&amp;id=5812d18a23&amp;f_id=0099bbe7f0"
        method="post"
        target="_blank"
        novalidate
        class="mt-8 grid gap-5"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="FNAME" class="block text-sm font-medium text-forest-800">First name <span class="text-copper-400">*</span></label>
            <input id="FNAME" name="FNAME" type="text" required class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
          </div>
          <div>
            <label for="EMAIL" class="block text-sm font-medium text-forest-800">Email <span class="text-copper-400">*</span></label>
            <input id="EMAIL" name="EMAIL" type="email" required class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800 focus:border-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-700/20" />
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="f-household" class="block text-sm font-medium text-forest-800">Household size</label>
            <select id="f-household" data-pref="Household" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Just me</option><option>Two of us</option><option>Three or four</option><option>Five or more</option><option>It varies</option></select>
          </div>
          <div>
            <label for="f-type" class="block text-sm font-medium text-forest-800">Home type that fits best</label>
            <select id="f-type" data-pref="Preferred home type" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Studio</option><option>One-bedroom</option><option>Two-bedroom</option><option>Three-bedroom</option><option>Townhome</option><option>Co-living / shared</option><option>Not sure yet</option></select>
          </div>
          <div>
            <label for="f-budget" class="block text-sm font-medium text-forest-800">Monthly housing budget comfort</label>
            <select id="f-budget" data-pref="Budget comfort" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Under $1,500</option><option>$1,500 to $2,000</option><option>$2,000 to $2,800</option><option>Above $2,800</option><option>Rather share later</option></select>
          </div>
          <div>
            <label for="f-access" class="block text-sm font-medium text-forest-800">Accessibility needs</label>
            <select id="f-access" data-pref="Accessibility" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>None right now</option><option>Step-free access matters</option><option>Single-level living matters</option><option>Other, in notes below</option></select>
          </div>
          <div>
            <label for="f-storage" class="block text-sm font-medium text-forest-800">Storage needs</label>
            <select id="f-storage" data-pref="Storage" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Standard</option><option>Extra, please</option><option>Bikes and outdoor gear</option></select>
          </div>
          <div>
            <label for="f-pets" class="block text-sm font-medium text-forest-800">Pets</label>
            <select id="f-pets" data-pref="Pets" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>None</option><option>Cat(s)</option><option>Dog(s)</option><option>A few of each</option></select>
          </div>
          <div>
            <label for="f-wfh" class="block text-sm font-medium text-forest-800">Work from home</label>
            <select id="f-wfh" data-pref="Work from home" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"><option value="">Choose</option><option>Most days</option><option>Sometimes</option><option>Rarely</option></select>
          </div>
        </div>
        <fieldset>
          <legend class="block text-sm font-medium text-forest-800">Shared amenities you would actually use</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-3">
            {['Shared kitchen and long table', 'Courtyard gardens', 'Workshop / maker space', 'Fitness and sauna', 'Guest suite to book', 'Coworking room'].map((a) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2.5 text-sm text-forest-800 hover:border-forest-700/40 has-[:checked]:border-forest-700 has-[:checked]:bg-forest-700/5"><input type="checkbox" data-prefcheck="Amenities" value={a} class="accent-forest-700" /> {a}</label>
            ))}
          </div>
        </fieldset>
        <div>
          <label for="f-notes" class="block text-sm font-medium text-forest-800">Anything else about your fit?</label>
          <p class="mt-1 text-xs text-stone-500">Including what you think about the cost question above. We read every one.</p>
          <textarea id="f-notes" rows="3" class="mt-2 w-full rounded-md border border-stone-200 bg-white px-4 py-3 text-base text-forest-800"></textarea>
        </div>
        <input type="hidden" name="NOTES" id="NOTES" value="" />
        <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="b_88bfb2c8f34fdd20e85cce03f_5812d18a23" tabindex="-1" value="" /></div>
        <div class="mt-2">
          <button type="submit" class="btn-primary">Help shape the home mix</button>
          <p class="mt-3 text-xs text-stone-500">Preference capture, never a lease or reservation. Occasional updates, unsubscribe anytime. See our <a href="/privacy" class="text-forest-700">privacy policy &amp; disclaimers</a>.</p>
        </div>
      </form>
    </div>
  </section>

  <SubFooter />
</Layout>

<script>
  const state = { size: 'all', fit: 'all', sort: 'small-large' };
  const cards = Array.from(document.querySelectorAll('.plan-card'));
  const grid = document.getElementById('plan-grid');
  const readout = document.getElementById('plan-readout');
  const emptyEl = document.getElementById('plan-empty');
  const fitWords = { all: '', solo: 'living solo', couple: 'two of you', family: 'a family', work: 'working from home', shared: 'sharing with others' };

  function activate(buttons, attr, value) {
    buttons.forEach((b) => {
      const on = b.dataset[attr] === value;
      b.classList.toggle('bg-forest-700', on);
      b.classList.toggle('text-cream-50', on);
      b.classList.toggle('border-forest-700', on);
      b.classList.toggle('bg-white', !on);
      b.classList.toggle('text-stone-600', !on);
      b.classList.toggle('border-stone-200', !on);
    });
  }
  const sizeBtns = Array.from(document.querySelectorAll('[data-fsize]'));
  const fitBtns = Array.from(document.querySelectorAll('[data-ffit]'));
  sizeBtns.forEach((b) => b.addEventListener('click', () => { state.size = b.dataset.fsize; activate(sizeBtns, 'fsize', state.size); apply(); }));
  fitBtns.forEach((b) => b.addEventListener('click', () => { state.fit = b.dataset.ffit; activate(fitBtns, 'ffit', state.fit); apply(); }));
  document.getElementById('plan-sort').addEventListener('change', (e) => { state.sort = e.target.value; apply(); });

  function apply() {
    const visible = [];
    cards.forEach((card) => {
      const sizeOk = state.size === 'all' || card.dataset.size === state.size;
      const fitOk = state.fit === 'all' || card.dataset.fit.split(' ').includes(state.fit);
      const show = sizeOk && fitOk;
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
      card.querySelectorAll('.fit-chip').forEach((chip) => {
        const on = state.fit !== 'all' && chip.dataset.fitchip === state.fit;
        chip.classList.toggle('border-forest-700', on);
        chip.classList.toggle('bg-forest-700/5', on);
        chip.classList.toggle('text-forest-700', on);
      });
    });
    visible.sort((a, b) => {
      if (state.sort === 'large-small') return +b.dataset.area - +a.dataset.area;
      if (state.sort === 'bedrooms') return +a.dataset.bedweight - +b.dataset.bedweight;
      return +a.dataset.area - +b.dataset.area;
    });
    visible.forEach((card) => grid.appendChild(card));

    const n = visible.length;
    const who = fitWords[state.fit];
    if (n) {
      const areas = visible.map((c) => +c.dataset.area);
      const range = `${Math.min(...areas)} to ${Math.max(...areas)} sq ft`;
      readout.textContent = who
        ? `${n} home ${n === 1 ? 'type' : 'types'} we are studying for ${who}, ${range}.`
        : `${n} home ${n === 1 ? 'type' : 'types'} under study, ${range}.`;
      emptyEl.classList.add('hidden');
    } else {
      readout.textContent = 'Nothing matches that combination yet.';
      emptyEl.classList.remove('hidden');
    }
  }
  apply();

  document.getElementById('fit-form').addEventListener('submit', () => {
    const parts = [];
    document.querySelectorAll('[data-pref]').forEach((el) => { if (el.value) parts.push(`${el.dataset.pref}: ${el.value}`); });
    const checked = Array.from(document.querySelectorAll('[data-prefcheck]:checked')).map((el) => el.value);
    if (checked.length) parts.push(`Amenities: ${checked.join(', ')}`);
    const notes = document.getElementById('f-notes').value.trim();
    if (notes) parts.push(`Notes: ${notes}`);
    document.getElementById('NOTES').value = `[Home types fit] ${parts.join(' | ')}`;
  });
</script>

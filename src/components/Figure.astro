---
import { Image } from 'astro:assets';
const {
  src, alt, cap = '',
  aspect = 'aspect-[16/9]',
  widths = [700, 1200, 1920],
  sizes = '(min-width: 768px) 50vw, 100vw',
  eager = false,
} = Astro.props;
---
<figure class="relative overflow-hidden rounded-md shadow-sm">
  <Image
          quality={68} src={src} alt={alt} widths={widths} sizes={sizes} class={`${aspect} h-auto w-full object-cover`} loading={eager ? 'eager' : 'lazy'} />
  {cap && (
    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-forest-900/80 via-forest-900/35 to-transparent px-5 pb-4 pt-12 text-[13px] leading-snug tracking-wide text-cream-50">
      {cap}
    </figcaption>
  )}
</figure>

---
import SiteFooter from './SiteFooter.astro';
---
<section class="py-section bg-cream-50">
  <div class="container-narrow text-center">
    <p class="eyebrow">Follow along</p>
    <h2 class="mt-4 font-display text-3xl text-forest-700 md:text-4xl">We are designing with you, not just for you.</h2>
    <p class="prose-body mx-auto mt-5 max-w-xl">Tell us who you are and where you would want a Now City neighborhood. We will keep you in the loop as the first one takes shape.</p>
    <p class="mt-8"><a href="/#follow-along" class="btn-primary">Join the List <span aria-hidden="true">→</span></a></p>
  </div>
</section>
<SiteFooter />

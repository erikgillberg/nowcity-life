---
// Branded "Setting Expectations" note. A trust element, used site-wide.
// variant: 'default' | 'compact' | 'dark'
const {
  variant = 'default',
  title = 'What is true today',
  body = 'This is just getting going, and it will unfold over the next several years. The vision is early and evolving, and we are not selling or leasing yet. Joining the list puts you first in line to hear about opportunities to pre-order and reserve a spot.',
  cta = true,
} = Astro.props;

const dark = variant === 'dark';
const compact = variant === 'compact';
---
<aside class={`not-prose relative overflow-hidden rounded-md border ${dark ? 'border-cream-300/25 bg-forest-800' : 'border-copper-400/35 bg-white'} ${compact ? 'p-5' : 'p-6 md:p-7'} ${compact ? 'mt-6' : 'mt-8'}`}>
  <span class={`absolute inset-y-0 left-0 w-[3px] ${dark ? 'bg-copper-300' : 'bg-copper-400'}`} aria-hidden="true"></span>
  <div class="pl-3">
    <div class="flex items-center gap-2.5">
      <svg viewBox="0 0 24 24" class={`h-4 w-4 flex-none ${dark ? 'text-copper-300' : 'text-copper-400'}`} fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M12 16v-4.5" stroke-linecap="round" /><circle cx="12" cy="8" r=".9" fill="currentColor" stroke="none" />
      </svg>
      <p class={`text-[11px] font-semibold uppercase tracking-[0.18em] ${dark ? 'text-copper-300' : 'text-copper-400'}`}>Setting expectations</p>
    </div>
    <p class={`mt-3 font-display ${compact ? 'text-lg' : 'text-xl'} ${dark ? 'text-cream-100' : 'text-forest-700'}`}>{title}</p>
    <p class={`mt-2 text-[15px] leading-relaxed ${dark ? 'text-cream-200/85' : 'text-stone-700'}`}>{body}</p>
    {cta && (
      <p class="mt-3.5">
        <a href="/#follow-along" class={`text-sm font-medium ${dark ? 'text-copper-300' : 'text-forest-700'}`}>Join the List →</a>
      </p>
    )}
  </div>
</aside>
